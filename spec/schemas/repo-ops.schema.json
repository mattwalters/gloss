{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/repo-ops.schema.json",
  "title": "Writ repository registry operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'repo'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create, set-slug, and add-remote. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "repo"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "repo"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "set-slug"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/set_slug_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "add-remote"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/add_remote_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "create_body": {
      "type": "object",
      "properties": {
        "slug": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/repo-slug"
        },
        "is_workspace": {
          "type": "boolean"
        }
      },
      "required": [
        "slug"
      ]
    },
    "set_slug_body": {
      "type": "object",
      "properties": {
        "slug": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/repo-slug"
        }
      },
      "required": [
        "slug"
      ]
    },
    "add_remote_body": {
      "type": "object",
      "properties": {
        "remote": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/remote-url"
        }
      },
      "required": [
        "remote"
      ]
    }
  }
}
