{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/settings-ops.schema.json",
  "title": "Writ workspace settings operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'settings'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for set. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "settings"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "settings"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "set"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/set_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "set_body": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "estimate_scale": {
          "type": "string",
          "enum": [
            "none",
            "fibonacci",
            "exponential",
            "linear",
            "t-shirt"
          ]
        },
        "allow_zero_estimates": {
          "type": "boolean"
        },
        "cycles_enabled": {
          "type": "boolean"
        },
        "cycle_duration_weeks": {
          "type": "integer",
          "minimum": 1
        },
        "cycle_start_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "cycle_cooldown_weeks": {
          "type": "integer",
          "minimum": 0
        },
        "triage_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
