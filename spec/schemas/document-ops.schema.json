{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/document-ops.schema.json",
  "title": "Writ document and section operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'document' and 'section'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create, update, link, label (document) and create, edit, move, update, delete (section). Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "enum": [
        "document",
        "section"
      ]
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "document"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/doc_create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/doc_update_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "link"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/doc_link_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "label"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/doc_label_body"
            }
          }
        }
      }
    ]
  },
  "else": {
    "if": {
      "properties": {
        "object_type": {
          "const": "section"
        },
        "op_version": {
          "const": 1
        }
      },
      "required": [
        "object_type",
        "op_version"
      ]
    },
    "then": {
      "allOf": [
        {
          "if": {
            "properties": {
              "op_type": {
                "const": "create"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/section_create_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op_type": {
                "const": "edit"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/section_edit_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op_type": {
                "const": "move"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/section_move_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op_type": {
                "const": "update"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/section_update_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op_type": {
                "const": "delete"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/section_delete_body"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "doc_create_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title"
      ]
    },
    "doc_update_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title"
      ]
    },
    "doc_link_body": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "relation"
      ]
    },
    "doc_label_body": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    "section_create_body": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "position",
        "body"
      ]
    },
    "section_edit_body": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "required": [
        "body"
      ]
    },
    "section_move_body": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        }
      },
      "required": [
        "position"
      ]
    },
    "section_update_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "position"
          ]
        }
      ]
    },
    "section_delete_body": {
      "type": "object",
      "maxProperties": 0,
      "description": "Delete body carries no content and is empty ({}) in v1."
    }
  }
}
