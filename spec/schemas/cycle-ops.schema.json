{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/cycle-ops.schema.json",
  "title": "Writ cycle operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'cycle'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create, update, set-dates, add-issue, and remove-issue. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "cycle"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "cycle"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/update_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "set-dates"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/set_dates_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "add-issue"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/add_issue_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "remove-issue"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/remove_issue_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "create_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "starts_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ends_at": {
          "$ref": "#/$defs/timestamp"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "starts_at",
        "ends_at"
      ]
    },
    "update_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    },
    "set_dates_body": {
      "type": "object",
      "properties": {
        "starts_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ends_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ]
    },
    "add_issue_body": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        }
      },
      "required": [
        "issue"
      ]
    },
    "remove_issue_body": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        }
      },
      "required": [
        "issue"
      ]
    }
  }
}
