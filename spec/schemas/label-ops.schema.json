{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/label-ops.schema.json",
  "title": "Writ label operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'label'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create and update. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "label"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "label"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/update_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "create_body": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "update_body": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "color"
          ]
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    }
  }
}
