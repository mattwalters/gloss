{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/workflow-state-ops.schema.json",
  "title": "Writ workflow state operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'workflow-state'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create and update. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "workflow-state"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "workflow-state"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/update_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "create_body": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/state_type"
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        },
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "position"
      ]
    },
    "update_body": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/state_type"
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        },
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "position"
          ]
        },
        {
          "required": [
            "color"
          ]
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    },
    "state_type": {
      "type": "string",
      "enum": [
        "backlog",
        "unstarted",
        "started",
        "completed",
        "canceled"
      ]
    }
  }
}
