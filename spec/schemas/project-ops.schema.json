{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/project-ops.schema.json",
  "title": "Writ project operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'project'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create, update, set-status, add-issue, and remove-issue. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "project"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "project"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/update_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "set-status"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/set_status_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "add-issue"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/add_issue_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "remove-issue"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/remove_issue_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "create_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "update_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    },
    "set_status_body": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "paused",
            "completed",
            "canceled"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "add_issue_body": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        }
      },
      "required": [
        "issue"
      ]
    },
    "remove_issue_body": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        }
      },
      "required": [
        "issue"
      ]
    }
  }
}
