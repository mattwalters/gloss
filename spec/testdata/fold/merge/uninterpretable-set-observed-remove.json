{
  "name": "uninterpretable-set-observed-remove",
  "description": "An OR-set item that is not a string makes the operation uninterpretable, on the add side and the remove side alike. A null item is the sharpest case: rendered rather than rejected it becomes a member of the set — an assignee nobody named — and a rejected remove leaves the element it named present, because a remove that cannot be read removes nothing. This is the nested body shape (§5.4). A side holds a string or an array of strings, so a bare string is one item; a side that is present and holds null is not an absent side but a write with no value in it, and is rejected like any other null",
  "object_id": "obj-1",
  "fields": {
    "labels": { "strategy": "set-observed-remove" }
  },
  "ops": [
    {
      "id": "op-a-good",
      "parents": [],
      "time": 100,
      "object_id": "obj-1",
      "body": {
        "labels": { "add": ["urgent", "triage"] }
      }
    },
    {
      "id": "op-b-number",
      "parents": ["op-a-good"],
      "time": 200,
      "object_id": "obj-1",
      "body": {
        "labels": { "add": [5] }
      }
    },
