      "object_id": "obj-1",
      "body": {
        "labels": { "add": [{ "email": "Carol@Example.COM" }] }
      }
    },
    {
      "id": "op-d-null-item",
      "parents": ["op-c-object"],
      "time": 400,
      "object_id": "obj-1",
